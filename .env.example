# Example settings (these are the defaults)

MONGO_URI=mongodb://localhost:27017/pdm
MQTT_URL=mqtt://localhost:1883

# AWS only - use SQS instead of MQTT between the services
USE_SQS=false
AWS_REGION=ap-southeast-2
FEATURES_QUEUE_URL=
HIGH_RISK_QUEUE_URL=

BROKER_PORT=1883
DASHBOARD_PORT=3000
INGESTION_PORT=3001
INFERENCE_PORT=3002
ALERTING_PORT=3003
INGESTION_URL=http://localhost:3001

# blank = ml/artifacts/model.json
MODEL_PATH=
RISK_THRESHOLD=0.7
CONSECUTIVE_BREACHES=3
ALERT_COOLDOWN_MS=900000
# extra CPU work per message, for the scaling demo
CPU_BURN_MS=0

API_KEY=local-dev-key
