# Copy to .env and adjust. Every service reads configuration from the
# environment, so the same code runs locally and on AWS.

# --- Storage -----------------------------------------------------------
# memory : no database required (tests, load tests, quick demos)
# mongo  : MongoDB, used for the recorded evidence
STORE_DRIVER=memory
MONGO_URI=
MONGO_DB_NAME=pdm

# --- Messaging ---------------------------------------------------------
# mqtt : local broker, one broker for telemetry and inter-service events
# sqs  : AWS deployment; queue depth drives inference auto-scaling
EVENT_BUS_DRIVER=mqtt
MQTT_URL=mqtt://localhost:1883
AWS_REGION=ap-southeast-2
# Required only when EVENT_BUS_DRIVER=sqs
SQS_QUEUE_URLS={}

# --- Ports -------------------------------------------------------------
BROKER_PORT=1883
DASHBOARD_PORT=3000
INGESTION_PORT=3001
INFERENCE_PORT=3002
ALERTING_PORT=3003
INGESTION_URL=http://localhost:3001

# --- Model and alerting policy ----------------------------------------
# Blank uses ml/artifacts/model.json
MODEL_PATH=
# Chosen from the threshold sweep printed by train_model.py
RISK_THRESHOLD=0.7
CONSECUTIVE_BREACHES=3
ALERT_COOLDOWN_MS=900000
# Artificial per-message work; only for making scale-out observable
CPU_BURN_MS=0

# --- Security ----------------------------------------------------------
# Never commit a real key. On AWS this comes from Secrets Manager.
API_KEY=local-dev-key
REQUIRE_API_KEY=true

LOG_LEVEL=info
