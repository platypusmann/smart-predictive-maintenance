diff --git a/packages/shared/src/messaging.js b/packages/shared/src/messaging.js
index bafc4b2..408ea61 100644
--- a/packages/shared/src/messaging.js
+++ b/packages/shared/src/messaging.js
@@ -45,16 +45,24 @@ async function publish(topic, message) {
   }
 }
 
-async function subscribe(topic, handler) {
+// `concurrency` controls how many messages from a single received batch are
+// handled at once. Default is 1, which reproduces the original strictly
+// one-at-a-time behaviour - important for a consumer like alerting, which
+// keeps per-machine streak state in memory and depends on that machine's
+// windows being handled in the order they arrive. A stateless consumer like
+// inference has no such ordering requirement, so it can opt into a higher
+// concurrency to overlap several in-flight Mongo writes instead of paying
+// each one's round trip serially. See docs/CAPACITY-PLANNING.md.
+async function subscribe(topic, handler, { concurrency = 1 } = {}) {
   if (config.useSqs) {
-    pollQueue(queueUrls[topic], handler); // not awaited, runs forever
+    pollQueue(queueUrls[topic], handler, concurrency); // not awaited, runs forever
   } else {
     handlers[topic] = handler;
     await mqttClient.subscribeAsync(topic, { qos: 1 });
   }
 }
 
-async function pollQueue(queueUrl, handler) {
+async function pollQueue(queueUrl, handler, concurrency) {
   while (true) {
     let messages = [];
     try {
@@ -67,16 +75,23 @@ async function pollQueue(queueUrl, handler) {
     } catch (err) {
       console.error(`SQS receive failed: ${err.message}`);
       await new Promise((resolve) => setTimeout(resolve, 2000));
+      continue;
     }
 
-    for (const msg of messages) {
-      try {
-        await handler(JSON.parse(msg.Body));
-        // only delete after it's handled, otherwise SQS gives it to someone else later
-        await sqs.send(new aws.DeleteMessageCommand({ QueueUrl: queueUrl, ReceiptHandle: msg.ReceiptHandle }));
-      } catch (err) {
-        console.error(`error handling message: ${err.message}`);
-      }
+    // Process the batch in chunks of `concurrency` messages at a time.
+    // Each message is handled and deleted independently, so one failure
+    // doesn't hold up the rest of its chunk or get retried twice.
+    for (let i = 0; i < messages.length; i += concurrency) {
+      const chunk = messages.slice(i, i + concurrency);
+      await Promise.all(chunk.map(async (msg) => {
+        try {
+          await handler(JSON.parse(msg.Body));
+          // only delete after it's handled, otherwise SQS gives it to someone else later
+          await sqs.send(new aws.DeleteMessageCommand({ QueueUrl: queueUrl, ReceiptHandle: msg.ReceiptHandle }));
+        } catch (err) {
+          console.error(`error handling message: ${err.message}`);
+        }
+      }));
     }
   }
 }
